{
  "name": "ecommerce-saas",
  "private": false,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "start": "turbo start",
    "lint": "turbo lint",
    "test": "turbo test",
    "backend:seed": "turbo seed --filter=@dtc/backend",
    "backend:dev": "turbo dev --filter=@dtc/backend",
    "backend:start": "turbo start --filter=@dtc/backend",
    "storefront:dev": "turbo dev --filter=@dtc/storefront"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "tsconfig-paths": "^4.2.0"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "msw",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@medusajs/eslint-plugin": "^2.21.2",
    "eslint": "^9.39.4",
    "jiti": "^2.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turbo": "^2.10.8"
  }
}
